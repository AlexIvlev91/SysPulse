<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SysPulse</AssemblyName>
    <RootNamespace>SysPulse</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>SysPulse</Product>
    <Description>CPU/GPU temperature and usage monitor with a turbo boost switch and a desktop overlay</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- CPU package temperature and power (needs administrator + the PawnIO driver). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
